generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}


model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  products  Product[]
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.Text
  price       Float
  stock       Int      @default(0)
  
  // Relasi ke Category (Many-to-One)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Relasi ke Image (One-to-Many)
  images      Image[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Image {
  id        String   @id @default(uuid())
  url       String   // URL dari Cloudinary, S3, atau path lokal
  publicId  String?  // Berguna jika menggunakan service seperti Cloudinary untuk delete
  
  // Relasi ke Product
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Distributor{
  id String @id @default(uuid())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
enum Role {
  ADMIN
  USER
}

model User {
  id String @id @default(ulid())
  email String @unique
  password String
  name String
  role Role @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
}